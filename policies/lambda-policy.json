{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartGlueWorkflow",
      "Effect": "Allow",
      "Action": [
        "glue:StartWorkflowRun"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-2:888783864938:*"
    }
  ]
}